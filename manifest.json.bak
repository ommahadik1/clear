{
  "manifest_version": 3,
  "name": "Prying Eyes",
  "version": "1.0",
  "description": "Zero-lag, webcam-based eye-tracking privacy extension.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "toggle-privacy-mask": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Instantly toggle the privacy mask on/off."
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["logger.js", "webgazer.js", "icon48.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["logger.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://tfhub.dev/ https://storage.googleapis.com/ https://*.googleusercontent.com/ https://*.googleapis.com/"
  }
}
